{
  "name": "@gratico/sdk",
  "version": "0.9.1",
  "author": "Abhishiv Saxena<abhishiv@gmail.com>",
  "license": "MIT",
  "type": "module",
  "description": "SDK for gratico platform",
  "keywords": [
    "gratico",
    "gratico-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gratico/sdk.git"
  },
  "files": [
    "./dist"
  ],
  "scripts": {
    "build": "make build",
    "test": "npx vitest --run --passWithNoTests",
    "coverage": "vitest run --coverage --run --passWithNoTests",
    "typecheck": "npx tsc --noEmit"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "optionalDependencies": {
    "alfama": "*",
    "@types/json-schema": "*"
  },
  "dependencies": {
    "emittery": "^1.0.3"
  },
  "devDependencies": {
    "esbuild": "^0.21.5",
    "typescript": "^5.2.2",
    "vitest": "^2.0.5"
  }
}
